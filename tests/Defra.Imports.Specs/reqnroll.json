{
  "$schema": "https://schemas.reqnroll.net/reqnroll-config-latest.json",
  "language": {
    "feature": "en-GB",
    "binding": "en-GB"
  },
  "runtime": {
    "missingOrPendingStepsOutcome": "Error",
    "obsoleteBehavior": "Warn"
  },
  "generator": {
    "allowRowTests": false
  },
  "MSTestRetrySettings": {
    "maxRetries": 2,
    "applyGlobally": false
  }
}