<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildToolsPath)\Microsoft.Common.targets" />

  <PropertyGroup>
    <NpmCommand Condition="'$(NpmCommand)' == '' and '$(OS)' == 'Windows_NT'">$(ProgramW6432)\nodejs\npm.cmd</NpmCommand>
    <NpmCommand Condition="'$(NpmCommand)' == ''">npm</NpmCommand>
    <NpmWorkingDirectory Condition="'$(NpmWorkingDirectory)' == ''">$(MSBuildThisFileDirectory)</NpmWorkingDirectory>
  </PropertyGroup>

  <Target Name="Build" DependsOnTargets="Restore">
    <Exec Command="&quot;$(NpmCommand)&quot; run build" WorkingDirectory="$(NpmWorkingDirectory)" />
  </Target>

  <Target Name="Restore">
    <Exec Command="&quot;$(NpmCommand)&quot; install --legacy-peer-deps" WorkingDirectory="$(NpmWorkingDirectory)" />
  </Target>

  <Target Name="GetProjectOutputPath" />

  <Target Name="Clean" />
</Project>
