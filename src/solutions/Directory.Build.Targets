<Project>
    <UsingTask
        TaskName="PackMissingDependencies"
        TaskFactory="RoslynCodeTaskFactory"
        AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <SolutionXml Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Xml" />
            <Code Type="Fragment" Language="cs">
                <![CDATA[
                Log.LogMessage(MessageImportance.High, $"Packing missing dependency files into {SolutionXml}.");
            
                var solution = new XmlDocument();
                solution.Load(SolutionXml);

                var sourceDirectory = Path.Combine(Path.GetDirectoryName(SolutionXml), "MissingDependencies");
                Log.LogMessage(MessageImportance.High, $"Using {sourceDirectory} folder.");

                var missingDependencyFiles = Directory.GetFiles(sourceDirectory);
                Log.LogMessage(MessageImportance.High, $"Found {missingDependencyFiles.Length} missing dependency files to pack.");

                Log.LogMessage(MessageImportance.High, "Removing any existing nodes from Solution.xml.");
                var missingDependenciesNode = solution.DocumentElement.SelectSingleNode("//MissingDependencies");
                missingDependenciesNode.RemoveAll();

                foreach (var file in missingDependencyFiles)
                {
                    var content = File.ReadAllText(file);
                    var missingDependencyXml = new XmlDocument();
                    missingDependencyXml.LoadXml(content);
                    
                    missingDependenciesNode.AppendChild(
                        solution.ImportNode(missingDependencyXml.DocumentElement, true));
                }

                Log.LogMessage(MessageImportance.High, "Saving Solution.xml.");
                solution.Save(SolutionXml);
                ]]>
            </Code>
        </Task>
    </UsingTask>
    <UsingTask
        TaskName="PackConnectionRoleAssociations"
        TaskFactory="RoslynCodeTaskFactory"
        AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <ConnectionRolesXml Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Xml" />
            <Code Type="Fragment" Language="cs">
                <![CDATA[
                Log.LogMessage(MessageImportance.High, $"Packing ConnectionRoleAssociations nodes into {ConnectionRolesXml}.");

                var xmlDoc = new XmlDocument();
                xmlDoc.Load(ConnectionRolesXml);

                var sourceDirectory = Path.Combine(Path.GetDirectoryName(ConnectionRolesXml), "ConnectionRoleAssociations");
                Log.LogMessage(MessageImportance.High, $"Using {sourceDirectory} folder.");

                var connectionRoleAssociationFiles = Directory.GetFiles(sourceDirectory);
                Log.LogMessage(MessageImportance.High, $"Found {connectionRoleAssociationFiles.Length} connection role association files to pack.");

                Log.LogMessage(MessageImportance.High, "Removing any existing nodes from ConnectionRoles.xml.");
                var connectionRoleAssociationsNode = xmlDoc.DocumentElement.SelectSingleNode("//ConnectionRoleAssociations");
                connectionRoleAssociationsNode.RemoveAll();

                foreach (var file in connectionRoleAssociationFiles)
                {
                    var content = File.ReadAllText(file);
                    var connectionRoleAssociationXml = new XmlDocument();
                    connectionRoleAssociationXml.LoadXml(content);

                    var connectionRoleAssociation = xmlDoc.ImportNode(connectionRoleAssociationXml.DocumentElement, true);
                    connectionRoleAssociationsNode.AppendChild(connectionRoleAssociation);
                }

                Log.LogMessage(MessageImportance.High, "Saving ConnectionRoles.xml.");
                xmlDoc.Save(ConnectionRolesXml);
                ]]>
            </Code>
        </Task>
    </UsingTask>
	<Target Name="EnsureSolutionVersionSet" Condition="'$(SolutionVersion)' == '' and '$(SolutionVersionStrategy)' == 'GitVersion' and '$(MSBuildProjectExtension)'=='.cdsproj'">
        <PropertyGroup>
            <PowerShellExe Condition=" '$(PowerShellExe)'=='' ">C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</PowerShellExe>
            <GetVersionScript Condition=" '$(ScriptLocation)'=='' ">$(MSBuildThisFileDirectory)..\..\scripts\Get-GitVersionSolutionVersion.ps1</GetVersionScript>
        </PropertyGroup>
        <Exec
            Command="$(PowerShellExe) -NonInteractive -ExecutionPolicy Unrestricted -Command &quot;&amp; { $(GetVersionScript) -MetadataPath '$(MSBuildProjectDirectory)\$(SolutionRootPath)' -MSBuildMode } 6>$null &quot;"
            ConsoleToMSBuild="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="SolutionVersionOutput" />
        </Exec>
        <Message Text="Output: $(SolutionVersionOutput)" />
        <XmlPeek XmlContent="$(SolutionVersionOutput)" Query="/SolutionVersion/Version/text()">
            <Output TaskParameter="Result" PropertyName="SolutionVersion" />
        </XmlPeek>
        <XmlPeek XmlContent="$(SolutionVersionOutput)" Query="/SolutionVersion/Part/text()">
            <Output TaskParameter="Result" PropertyName="SolutionVersionPart" />
        </XmlPeek>
    </Target>
    <Target Name="PackMissingDependencies"
        Condition="Exists('$(MSBuildProjectDirectory)\$(SolutionRootPath)\Other\MissingDependencies')"
        AfterTargets="CopyCdsSolutionContent" BeforeTargets="PowerAppsPackage">
        <PackMissingDependencies
            SolutionXml="$(SolutionPackagerMetadataWorkingDirectory)\Other\Solution.xml" />
    </Target>
    <Target Name="PackConnectionRoleAssociations"
        Condition="Exists('$(MSBuildProjectDirectory)\$(SolutionRootPath)\Other\ConnectionRoleAssociations')"
        AfterTargets="CopyCdsSolutionContent" BeforeTargets="PowerAppsPackage">
        <PackConnectionRoleAssociations
            ConnectionRolesXml="$(SolutionPackagerMetadataWorkingDirectory)\Other\ConnectionRoles.xml" />
    </Target>
	<!-- The solution metadata gets copied to the obj folder before the pack target starts. We need
    to transform it for pack operations to avoid needing to separate mapping files for packing and
    unpacking. We just prepend '..\..\' to the mapping 'to' paths. -->
    <Target Name="TransformMappingFile" BeforeTargets="PowerAppsPackage">
        <Copy SourceFiles="$(SolutionPackageMapSourceFilePath)"
            DestinationFolder="$(IntermediateOutputPath)" />
        <XmlPeek XmlInputPath="$(SolutionPackageMapFilePath)" Query="/Mapping/*/@to">
            <Output TaskParameter="Result" ItemName="MappingDirective" />
        </XmlPeek>
        <XmlPoke XmlInputPath="$(SolutionPackageMapFilePath)"
            Value="..\..\%(MappingDirective.Identity)"
            Query="/Mapping/*/@to[.='%(MappingDirective.Identity)']" />
    </Target>
</Project>