          "metadata": {
            "operationMetadataId": "3987d1f4-c851-4114-b66a-0546b63f4a34"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "defraimp_importapplication",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "defraimp_tracesspeciesid,defraimp_ipaffsspeciesid,defraimp_commoditycode",
              "subscriptionRequest/filterexpression": "defraimp_commoditycode ne null"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Init_Commodity_Type_Mappings_Array": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "087e3454-8e3f-46f9-9a51-9c779d927b31"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "CommodityTypeMappingsArray",
                "type": "array"
              }
            ]
          }
        },
        "Get_Records_with_a_matching_Commodity_Code": {
          "actions": {
            "List_records": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "fd268b8e-cccf-4299-9442-9cf0702a9dab"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "defraimp_commoditytypemappings",
                  "$filter": "defraimp_commoditycode eq '@{triggerOutputs()?['body/defraimp_commoditycode']}'"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Apply_to_each": {
              "foreach": "@outputs('List_records')?['body/value']",
              "actions": {
                "Append_to_array_variable": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "12fd6923-611e-4d4d-97bc-0b46226bb5b8"
                  },
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "CommodityTypeMappingsArray",
                    "value": "@items('Apply_to_each')"
                  }
                }
              },
              "runAfter": {
                "List_records": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "3cff33fc-8370-42ba-9c45-3ac789db6098"
              },
              "type": "Foreach"
            }
          },
          "runAfter": {
            "Retrieve_\"Other\"_Commodity_Type": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "15e33938-ca4a-4124-9441-c51a5b2197af"
          },
          "type": "Scope"
        },
        "Init_Commodity_Type_Variable": {
          "runAfter": {
            "Init_Commodity_Type_Mappings_Array": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "1d0f31bb-44d7-4b92-abef-fda7f000427c"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "CommodityType",
                "type": "string"
              }
            ]
          }
        },
        "Filter_Commodity_Type_Mappings_using_the_Species_ID_(If_we_have_more_than_1)": {
          "actions": {
            "Check_if_we_have_found_any_Commodity_Type_Mappings": {
              "actions": {
                "Check_if_we_have_more_than_1_record": {
                  "actions": {
                    "Filter_array": {
                      "runAfter": {},
                      "metadata": {
                        "operationMetadataId": "2a1dd8a1-6c0e-43a9-be59-565903ea3fa0"
                      },
                      "type": "Query",
                      "inputs": {
                        "from": "@outputs('List_records')?['body/value']",
                        "where": "@or(and(equals(item()?['body/defraimp_tracesspeciesid'],triggerOutputs()?['body/defraimp_tracesspeciesid']),not(empty(triggerOutputs()?['body/defraimp_tracesspeciesid']))),and(equals(item()?['defraimp_ipaffsspeciesid'], triggerOutputs()?['body/defraimp_ipaffsspeciesid']),not(empty(triggerOutputs()?['body/defraimp_ipaffsspeciesid']))))"
                      }
                    },
                    "Set_Commodity_Type": {
                      "runAfter": {
                        "Filter_array": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "71992458-9650-4e72-98d8-d370311058a9"
                      },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "CommodityType",
                        "value": "@{first(array(body('Filter_array')))?['_defraimp_commoditytype_value']}"
                      }
                    },
                    "Make_sure_Commodity_Type_is_not_Null": {
                      "actions": {
                        "Set_Commodity_Type_as_\"Other_Commodity_Type\"_because_it_was_null": {
                          "runAfter": {},
                          "metadata": {
                            "operationMetadataId": "0a66ef35-43d8-4070-b0b4-856fce8ea251"
                          },
                          "type": "SetVariable",
                          "inputs": {
                            "name": "CommodityType",
                            "value": "@variables('\"Other\" Commodity Type')"
                          }
                        }
                      },
                      "runAfter": {
                        "Set_Commodity_Type": [
                          "Succeeded"
                        ]
                      },
                      "expression": {
                        "equals": [
                          "@empty(variables('CommodityType'))",
                          "@true"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "94e48b6b-6315-4eb9-9ce4-5b8a6368622b"
                      },
                      "type": "If"
                    }
                  },
                  "runAfter": {},
                  "else": {
                    "actions": {
                      "Set_the_Commodity_Type_from_the_one_record_we_have": {
                        "foreach": "@outputs('List_records')?['body/value']",
                        "actions": {
                          "Set_variable": {
                            "runAfter": {},
                            "metadata": {
                              "operationMetadataId": "8e8bbb46-55fe-49e2-81ef-c68a8b259147"
                            },
                            "type": "SetVariable",
                            "inputs": {
                              "name": "CommodityType",
                              "value": "@items('Set_the_Commodity_Type_from_the_one_record_we_have')?['_defraimp_commoditytype_value']"
                            }
                          }
                        },
                        "runAfter": {},
                        "metadata": {
                          "operationMetadataId": "62028119-8cf3-4fb5-94fc-7a28e4d12ece"
                        },
                        "type": "Foreach"
                      }
                    }
                  },
                  "expression": {
                    "greater": [
                      "@length(variables('CommodityTypeMappingsArray'))",
                      1
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "d68ddf43-9e15-4556-839a-661d8224288e"
                  },
                  "type": "If"
                }
              },
              "runAfter": {},
              "else": {
                "actions": {
                  "No_Matching_Commodity_Code_-_Update_Import_Record_Commodity_Type_to_\"Other\"": {
                    "runAfter": {},
                    "metadata": {
                      "operationMetadataId": "10fe3ca9-005d-4f72-86c7-abb25b9c5d22"
                    },
                    "type": "SetVariable",
                    "inputs": {
                      "name": "CommodityType",
                      "value": "@variables('\"Other\" Commodity Type')"
                    }
                  }
                }
              },
              "expression": {
                "greater": [
                  "@length(variables('CommodityTypeMappingsArray'))",
                  0
                ]
              },
              "metadata": {
                "operationMetadataId": "f5527f02-eea1-4a7f-a49e-15dcc5649e22"
              },
              "type": "If"
            }
          },
          "runAfter": {
            "Get_Records_with_a_matching_Commodity_Code": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "61203733-dffb-4ecb-99dd-900c7c0d766b"
          },
          "type": "Scope"
        },
        "Append_the_related_Commodity_Type_if_we_have_one": {
          "actions": {
            "Check_Commodity_Type_has_been_populated": {
              "actions": {
                "Update_the_record_with_the_Commodity_Type": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "016746ea-391d-41fd-b989-94f6efe47c17"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "defraimp_importapplications",
                      "recordId": "@triggerOutputs()?['body/defraimp_importapplicationid']",
                      "item/defraimp_CommodityTypeId@odata.bind": "/defraexp_commoditytypes(@{variables('CommodityType')})"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "runAfter": {},
              "else": {
                "actions": {
                  "Terminate_2": {
                    "runAfter": {},
                    "metadata": {
                      "operationMetadataId": "24f01c0a-bb39-43ad-98af-0cda6797eec5"
                    },
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "message": "No related Commodity Type was found.\nTRACES Commodity Code: @{triggerOutputs()?['body/defraimp_tracescommoditycode']}\nTRACES Species ID: @{triggerOutputs()?['body/defraimp_tracesspeciesid']}\nIPAFFS Commodity Code: @{triggerOutputs()?['body/defraimp_ipaffscommoditycode']}\nIPAFFS Species ID: @{triggerOutputs()?['body/defraimp_ipaffsspeciesid']}"
                      }
                    }
                  }
                }
              },
              "expression": {
                "not": {
                  "equals": [
                    "@variables('CommodityType')",
                    "@null"
                  ]
                }
              },
              "metadata": {
                "operationMetadataId": "7c8fb23f-e327-40df-adf8-24aa70c9b66c"
              },
              "type": "If"
            }
          },
          "runAfter": {
            "Filter_Commodity_Type_Mappings_using_the_Species_ID_(If_we_have_more_than_1)": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "c8f046f4-48fc-4198-b117-5b44813500e9"
          },
          "type": "Scope"
        },
        "Init_\"Other\"_Commodity_Type": {
          "runAfter": {
            "Init_Commodity_Type_Variable": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "2dfee1b2-0802-429d-aad8-a6c0bbf2290d"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "\"Other\" Commodity Type",
                "type": "string"
              }
            ]
          }
        },
        "Retrieve_\"Other\"_Commodity_Type": {
          "actions": {
            "List_Commodity_Types_with_name_\"Other\"": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "4036af29-2c3a-44db-87d8-92a5e2cd1e97"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "defraexp_commoditytypes",
                  "$filter": "defraexp_name eq 'OTHER'"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Loop_through_List_of_Commodity_Types_(We_should_only_retrieve_one)": {
              "foreach": "@outputs('List_Commodity_Types_with_name_\"Other\"')?['body/value']",
              "actions": {
                "Set_the_\"Other\"_Commodity_Type": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "3d02267c-ae64-4667-965c-a7ebaa15a33b"
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "\"Other\" Commodity Type",
                    "value": "@items('Loop_through_List_of_Commodity_Types_(We_should_only_retrieve_one)')?['defraexp_commoditytypeid']"
                  }
                }
              },
              "runAfter": {
                "List_Commodity_Types_with_name_\"Other\"": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "3965f9d3-35ad-4e66-a3fb-18928deca356"
              },
              "type": "Foreach"
            }
          },
          "runAfter": {
            "Init_\"Other\"_Commodity_Type": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "55557ddf-a4a3-4834-a414-df03822745c4"
          },
          "type": "Scope"
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
