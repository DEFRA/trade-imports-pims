{
  "properties": {
    "connectionReferences": {
      "shared_commondataservice": {
        "runtimeSource": "embedded",
        "connection": {},
        "api": {
          "name": "shared_commondataservice"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_record_is_created": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataservice",
              "connectionName": "shared_commondataservice",
              "operationId": "SubscribeOnNewItems"
            },
            "parameters": {
              "dataset": "default.cds",
              "table": "defraimp_importernotifications",
              "scope": "Organization"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Delay": {
          "runAfter": {},
          "type": "Wait",
          "inputs": {
            "interval": {
              "count": 30,
              "unit": "Day"
            }
          }
        },
        "Is_Related_Match_Records_Array_Greater_Than_0": {
          "actions": {
            "For_Each_Match_Record_-_Filter_for_the_Status_Reason": {
              "foreach": "@outputs('List_records_-_Related_Match_Records')?['body/value']",
              "actions": {
                "Check_if_Any_Match_Records_are_marked_as_Matched": {
                  "actions": {
                    "Set_foundCompletedMatchRecord_to_True": {
                      "runAfter": {},
                      "type": "SetVariable",
                      "inputs": {
                        "name": "foundCompletedMatchRecord",
                        "value": "@true"
                      }
                    }
                  },
                  "runAfter": {},
                  "expression": {
                    "equals": [
                      "@items('For_Each_Match_Record_-_Filter_for_the_Status_Reason')?['statuscode']",
                      2
                    ]
                  },
                  "type": "If"
                }
              },
              "runAfter": {},
              "type": "Foreach",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 20
                }
              }
            },
            "If_there_is_a_Completed_Match_Record": {
              "actions": {},
              "runAfter": {
                "For_Each_Match_Record_-_Filter_for_the_Status_Reason": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {
                  "Update_Status_of_Importer_Notification_-_Archive_(No_Completed_Match)": {
                    "runAfter": {},
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataservice",
                        "connectionName": "shared_commondataservice",
                        "operationId": "PatchItem_V2"
                      },
                      "parameters": {
                        "dataset": "default.cds",
                        "table": "defraimp_importernotifications",
                        "id": "@triggerOutputs()?['body/defraimp_importernotificationid']",
                        "item/statuscode": 2,
                        "item/statecode": 1,
                        "item/_ownerid_type": ""
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  }
                }
              },
              "expression": {
                "equals": [
                  "@variables('foundCompletedMatchRecord')",
                  "@true"
                ]
              },
              "type": "If"
            }
          },
          "runAfter": {
            "Populate_relatedMatchRecords": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Update_Status_of_Importer_Notification_-_Archive_(No_Records)": {
                "runAfter": {},
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataservice",
                    "connectionName": "shared_commondataservice",
                    "operationId": "PatchItem_V2"
                  },
                  "parameters": {
                    "dataset": "default.cds",
                    "table": "defraimp_importernotifications",
                    "id": "@triggerOutputs()?['body/defraimp_importernotificationid']",
                    "item/statuscode": 2,
                    "item/statecode": 1,
                    "item/_ownerid_type": ""
                  },
                  "authentication": "@parameters('$authentication')"
                }
              }
            }
          },
          "expression": {
            "greater": [
              "@length(variables('relatedMatchRecords'))",
              0
            ]
          },
          "type": "If"
        },
        "Initialize_relatedMatchRecords_Array": {
          "runAfter": {
            "Delay": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "relatedMatchRecords",
                "type": "array"
              }
            ]
          }
        },
        "Populate_relatedMatchRecords": {
          "actions": {
            "List_records_-_Related_Match_Records": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataservice",
                  "connectionName": "shared_commondataservice",
                  "operationId": "GetItems_V2"
                },
                "parameters": {
                  "dataset": "default.cds",
                  "table": "defraimp_matchrecords",
                  "$filter": "defraimp_ImporterNotification/defraimp_importernotificationid eq @{triggerOutputs()?['body/defraimp_importernotificationid']}"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "For_Each_Related_Match_Record_-_Populate_relatedMatchRecords_Array": {
              "foreach": "@outputs('List_records_-_Related_Match_Records')?['body/value']",
              "actions": {
                "Append_to_array_variable": {
                  "runAfter": {},
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "relatedMatchRecords",
                    "value": "@items('For_Each_Related_Match_Record_-_Populate_relatedMatchRecords_Array')"
                  }
                }
              },
              "runAfter": {
                "List_records_-_Related_Match_Records": [
                  "Succeeded"
                ]
              },
              "type": "Foreach"
            }
          },
          "runAfter": {
            "Initialize_variable": [
              "Succeeded"
            ]
          },
          "type": "Scope"
        },
        "Initialize_variable": {
          "runAfter": {
            "Initialize_relatedMatchRecords_Array": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "foundCompletedMatchRecord",
                "type": "boolean",
                "value": "@false"
              }
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}