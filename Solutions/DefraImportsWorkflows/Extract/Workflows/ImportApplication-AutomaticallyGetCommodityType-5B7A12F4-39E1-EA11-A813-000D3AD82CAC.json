{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {},
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_record_is_created,_updated_or_deleted": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "defraimp_importapplication",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "defraimp_tracesspeciesid,defraimp_ipaffsspeciesid,defraimp_commoditycode",
              "subscriptionRequest/filterexpression": "defraimp_commoditycode ne null"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Init_Commodity_Type_Mappings_Array": {
          "runAfter": {},
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "CommodityTypeMappingsArray",
                "type": "array"
              }
            ]
          }
        },
        "Get_Records_with_a_matching_Commodity_Code": {
          "actions": {
            "List_records": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "defraimp_commoditytypemappings",
                  "$filter": "defraimp_commoditycode eq '@{triggerOutputs()?['body/defraimp_commoditycode']}'"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Apply_to_each": {
              "foreach": "@outputs('List_records')?['body/value']",
              "actions": {
                "Append_to_array_variable": {
                  "runAfter": {},
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "CommodityTypeMappingsArray",
                    "value": "@items('Apply_to_each')"
                  }
                }
              },
              "runAfter": {
                "List_records": [
                  "Succeeded"
                ]
              },
              "type": "Foreach"
            }
          },
          "runAfter": {
            "Retrieve_\"Other\"_Commodity_Type": [
              "Succeeded"
            ]
          },
          "type": "Scope"
        },
        "Init_Commodity_Type_Variable": {
          "runAfter": {
            "Init_Commodity_Type_Mappings_Array": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "CommodityType",
                "type": "string"
              }
            ]
          }
        },
        "Filter_Commodity_Type_Mappings_using_the_Species_ID_(If_we_have_more_than_1)": {
          "actions": {
            "Check_if_we_have_found_any_Commodity_Type_Mappings": {
              "actions": {
                "Check_if_we_have_more_than_1_record": {
                  "actions": {
                    "Filter_array": {
                      "runAfter": {},
                      "type": "Query",
                      "inputs": {
                        "from": "@outputs('List_records')?['body/value']",
                        "where": "@or(and(equals(item()?['body/defraimp_tracesspeciesid'],triggerOutputs()?['body/defraimp_tracesspeciesid']),not(empty(triggerOutputs()?['body/defraimp_tracesspeciesid']))),and(equals(item()?['defraimp_ipaffsspeciesid'], triggerOutputs()?['body/defraimp_ipaffsspeciesid']),not(empty(triggerOutputs()?['body/defraimp_ipaffsspeciesid']))))"
                      }
                    },
                    "Set_Commodity_Type": {
                      "runAfter": {
                        "Filter_array": [
                          "Succeeded"
                        ]
                      },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "CommodityType",
                        "value": "@{first(array(body('Filter_array')))?['_defraimp_commoditytype_value']}"
                      }
                    },
                    "Make_sure_Commodity_Type_is_not_Null": {
                      "actions": {
                        "Set_Commodity_Type_as_\"Other_Commodity_Type\"_because_it_was_null": {
                          "runAfter": {},
                          "type": "SetVariable",
                          "inputs": {
                            "name": "CommodityType",
                            "value": "@variables('\"Other\" Commodity Type')"
                          }
                        }
                      },
                      "runAfter": {
                        "Set_Commodity_Type": [
                          "Succeeded"
                        ]
                      },
                      "expression": {
                        "equals": [
                          "@empty(variables('CommodityType'))",
                          "@true"
                        ]
                      },
                      "type": "If"
                    }
                  },
                  "runAfter": {},
                  "else": {
                    "actions": {
                      "Set_the_Commodity_Type_from_the_one_record_we_have": {
                        "foreach": "@outputs('List_records')?['body/value']",
                        "actions": {
                          "Set_variable": {
                            "runAfter": {},
                            "type": "SetVariable",
                            "inputs": {
                              "name": "CommodityType",
                              "value": "@items('Set_the_Commodity_Type_from_the_one_record_we_have')?['_defraimp_commoditytype_value']"
                            }
                          }
                        },
                        "runAfter": {},
                        "type": "Foreach"
                      }
                    }
                  },
                  "expression": {
                    "greater": [
                      "@length(variables('CommodityTypeMappingsArray'))",
                      1
                    ]
                  },
                  "type": "If"
                }
              },
              "runAfter": {},
              "else": {
                "actions": {
                  "No_Matching_Commodity_Code_-_Update_Import_Record_Commodity_Type_to_\"Other\"": {
                    "runAfter": {},
                    "type": "SetVariable",
                    "inputs": {
                      "name": "CommodityType",
                      "value": "@variables('\"Other\" Commodity Type')"
                    }
                  }
                }
              },
              "expression": {
                "greater": [
                  "@length(variables('CommodityTypeMappingsArray'))",
                  0
                ]
              },
              "type": "If"
            }
          },
          "runAfter": {
            "Get_Records_with_a_matching_Commodity_Code": [
              "Succeeded"
            ]
          },
          "type": "Scope"
        },
        "Append_the_related_Commodity_Type_if_we_have_one": {
          "actions": {
            "Check_Commodity_Type_has_been_populated": {
              "actions": {
                "Update_the_record_with_the_Commodity_Type": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "defraimp_importapplications",
                      "recordId": "@triggerOutputs()?['body/defraimp_importapplicationid']",
                      "item/defraimp_CommodityTypeId@odata.bind": "/defraexp_commoditytypes(@{variables('CommodityType')})"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "runAfter": {},
              "else": {
                "actions": {
                  "Terminate_2": {
                    "runAfter": {},
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "message": "No related Commodity Type was found.\nTRACES Commodity Code: @{triggerOutputs()?['body/defraimp_tracescommoditycode']}\nTRACES Species ID: @{triggerOutputs()?['body/defraimp_tracesspeciesid']}\nIPAFFS Commodity Code: @{triggerOutputs()?['body/defraimp_ipaffscommoditycode']}\nIPAFFS Species ID: @{triggerOutputs()?['body/defraimp_ipaffsspeciesid']}"
                      }
                    }
                  }
                }
              },
              "expression": {
                "not": {
                  "equals": [
                    "@variables('CommodityType')",
                    "@null"
                  ]
                }
              },
              "type": "If"
            }
          },
          "runAfter": {
            "Filter_Commodity_Type_Mappings_using_the_Species_ID_(If_we_have_more_than_1)": [
              "Succeeded"
            ]
          },
          "type": "Scope"
        },
        "Init_\"Other\"_Commodity_Type": {
          "runAfter": {
            "Init_Commodity_Type_Variable": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "\"Other\" Commodity Type",
                "type": "string"
              }
            ]
          }
        },
        "Retrieve_\"Other\"_Commodity_Type": {
          "actions": {
            "List_Commodity_Types_with_name_\"Other\"": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "defraexp_commoditytypes",
                  "$filter": "defraexp_name eq 'OTHER'"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Loop_through_List_of_Commodity_Types_(We_should_only_retrieve_one)": {
              "foreach": "@outputs('List_Commodity_Types_with_name_\"Other\"')?['body/value']",
              "actions": {
                "Set_the_\"Other\"_Commodity_Type": {
                  "runAfter": {},
                  "type": "SetVariable",
                  "inputs": {
                    "name": "\"Other\" Commodity Type",
                    "value": "@items('Loop_through_List_of_Commodity_Types_(We_should_only_retrieve_one)')?['defraexp_commoditytypeid']"
                  }
                }
              },
              "runAfter": {
                "List_Commodity_Types_with_name_\"Other\"": [
                  "Succeeded"
                ]
              },
              "type": "Foreach"
            }
          },
          "runAfter": {
            "Init_\"Other\"_Commodity_Type": [
              "Succeeded"
            ]
          },
          "type": "Scope"
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}